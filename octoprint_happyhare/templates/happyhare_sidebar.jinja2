<div class="hh-side" id="hh-side">
  <div class="hh-side-head">
    <span class="hh-spool" id="hh-side-spool"></span>
    <div>
      <div class="hh-side-tool" id="hh-side-tool">MMU</div>
      <div class="hh-hint" id="hh-side-material">waiting for Klipper…</div>
    </div>
    <span class="hh-badge mute" id="hh-side-state"></span>
  </div>
  <dl class="hh-kv">
    <dt>Filament</dt><dd id="hh-side-filament">—</dd>
    <dt>Position</dt><dd id="hh-side-position">—</dd>
    <dt>Action</dt><dd id="hh-side-action">—</dd>
  </dl>
  <div class="hh-side-meter" id="hh-side-encoder" hidden>
    <div class="hh-hint hh-between"><span>Encoder headroom</span><span id="hh-side-headroom"></span></div>
    <div class="hh-meter"><i id="hh-side-headroom-bar"></i></div>
  </div>
  <div class="hh-row hh-side-buttons">
    <button class="btn btn-small hh-grow" id="hh-side-unload">Unload</button>
    <button class="btn btn-small hh-grow" id="hh-side-recover">Recover</button>
  </div>

  <div class="hh-sensors" id="hh-sensors">
    <div class="hh-between hh-sensors-head">
      <span class="hh-label">Sensors</span>
      <button class="btn btn-mini" id="hh-sensors-refresh"
              title="Runs QUERY_ENDSTOPS and QUERY_PROBE — the switches update on their own, endstops and the probe only when asked">Refresh</button>
    </div>
    <div id="hh-sensors-list"></div>
  </div>

  <div class="hh-hint" id="hh-side-link"></div>
</div>
