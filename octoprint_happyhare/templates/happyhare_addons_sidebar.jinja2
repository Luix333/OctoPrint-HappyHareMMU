<div class="hh-side" id="hh-side-addons">
  <div class="hh-addons-empty hh-hint" id="hh-addons-empty">No MMU add-ons detected.</div>
  <div id="hh-side-blobifier" hidden>
    <div class="hh-between hh-sensors-head">
      <span class="hh-label">Blobifier</span>
      <span class="hh-badge mute" id="hh-side-blob-badge"></span>
    </div>
    <div class="hh-hint hh-between"><span>Purge bucket</span>
      <span id="hh-side-blob-count">—</span></div>
    <div class="hh-meter" style="margin-top:4px"><i id="hh-side-blob-bar"></i></div>
    <div class="hh-hint" id="hh-side-blob-shake" style="margin-top:5px"></div>
    <div class="hh-row hh-side-buttons">
      <button class="btn btn-small hh-grow" id="hh-side-blob-reset">Bucket emptied</button>
      <button class="btn btn-small hh-grow" id="hh-side-blob-shake-btn">Shake</button>
    </div>
  </div>
</div>
